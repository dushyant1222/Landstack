# Relative by default so the dev proxy / nginx keeps the session cookie same-origin.
VITE_API_BASE_URL=/api/v1
# Optional: override the map tile provider (must allow your usage and include attribution).
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
