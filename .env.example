# Copy to .env and fill in. Never commit .env. Generate secrets with:
#   python3 -c "import secrets; print(secrets.token_hex(24))"

# --- Database (docker compose creates the database with this password) ---
LANDSTACK_DB_URL=jdbc:postgresql://localhost:5432/landstack
LANDSTACK_DB_USER=landstack
LANDSTACK_DB_PASSWORD=

# --- Backend ---
# Private directory for uploaded files (outside any web root). Required.
LANDSTACK_STORAGE_DIR=
LANDSTACK_MAX_UPLOAD_MB=20
LANDSTACK_MAX_UPLOAD_BYTES=20971520
LANDSTACK_CORS_ORIGINS=http://localhost:5173
LANDSTACK_SESSION_TIMEOUT=30m
# true when served over HTTPS
LANDSTACK_COOKIE_SECURE=false
LANDSTACK_IP_HASH_SALT=
# dev | (empty for production-like). The dev profile enables Swagger UI and demo-account seeding.
LANDSTACK_PROFILE=dev
# Password for the three dev demo accounts (admin@/operator@/reviewer@landstack.demo). Dev profile only.
LANDSTACK_DEMO_PASSWORD=
# Optional first administrator when the user table is empty (non-dev deployments).
LANDSTACK_BOOTSTRAP_ADMIN_EMAIL=
LANDSTACK_BOOTSTRAP_ADMIN_PASSWORD=

# --- Optional PDF processing service ---
LANDSTACK_PROCESSING_ENABLED=true
LANDSTACK_PROCESSING_URL=http://localhost:8090
# Shared secret; the processing service uses the same value as PROCESSING_TOKEN (min 16 chars).
LANDSTACK_PROCESSING_TOKEN=

# --- Frontend (Vite) ---
VITE_API_BASE_URL=/api/v1
